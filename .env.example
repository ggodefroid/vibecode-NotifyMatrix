# Copy this file to `.env`, then fill in your real credentials (never commit `.env`):
#   cp .env.example .env
#
# PlatformIO reads `.env` at build time and injects these values as compiler defines.

WIFI_SSID=YourWiFiSSID
WIFI_PASSWORD=your_wifi_password

MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_NOTIFY=notifymatrix/notify

# Carousel: display time per line (ms)
CAROUSEL_HOLD_MS=3500
CAROUSEL_HOLD_NO_INFO_MS=3000

# PRIM / Ile-de-France Mobilites — key from https://prim.iledefrance-mobilites.fr
IDFM_API_KEY=YOUR_PRIM_API_KEY

# ---------------------------------------------------------------------------
# Mode A: single line
# ---------------------------------------------------------------------------
# Keep IDFM_SLOT_COUNT=0 and set the single-line fields below.

#IDFM_SLOT_COUNT=0
#IDFM_MONITORING_REF=STIF:StopPoint:Q:15352:
#IDFM_LINE_REF=STIF:Line::C00628:
#IDFM_LINE_LABEL=2225
#IDFM_LINE_CODE=C00628

# ---------------------------------------------------------------------------
# Mode B: carousel
# ---------------------------------------------------------------------------
# To enable the carousel, set IDFM_SLOT_COUNT and fill IDFM_SLOT_N_* entries.
#
 IDFM_SLOT_COUNT=9
 IDFM_SLOT_0_MONITORING_REF=STIF:StopPoint:Q:15352:
 IDFM_SLOT_0_LINE_REF=STIF:Line::C00628:
 IDFM_SLOT_0_LINE_CODE=C00628
 IDFM_SLOT_0_LABEL=2225

 IDFM_SLOT_1_MONITORING_REF=STIF:StopPoint:Q:15405:
 IDFM_SLOT_1_LINE_REF=STIF:Line::C00627:
 IDFM_SLOT_1_LINE_CODE=C00627
 IDFM_SLOT_1_LABEL=2223

 IDFM_SLOT_2_MONITORING_REF=STIF:StopPoint:Q:15687:
 IDFM_SLOT_2_LINE_REF=STIF:Line::C01879:
 IDFM_SLOT_2_LINE_CODE=C01879
 IDFM_SLOT_2_LABEL=2224
 IDFM_SLOT_2_PREFER_THEORETICAL=0

 # Noctilien N141 → Gare de l'Est (arrêt bus Foch / Paix Notre Dame)
 IDFM_SLOT_3_MONITORING_REF=STIF:StopPoint:Q:471093:
 IDFM_SLOT_3_LINE_REF=STIF:Line::C01639:
 IDFM_SLOT_3_LINE_CODE=C01639
 IDFM_SLOT_3_LABEL=N141

 IDFM_SLOT_4_MONITORING_REF=STIF:StopPoint:Q:15687:
 IDFM_SLOT_4_LINE_REF=STIF:Line::C00625:
 IDFM_SLOT_4_LINE_CODE=C00625
 IDFM_SLOT_4_LABEL=2221

 IDFM_SLOT_5_MONITORING_REF=STIF:StopPoint:Q:15687:
 IDFM_SLOT_5_LINE_REF=STIF:Line::C00634:
 IDFM_SLOT_5_LINE_CODE=C00634
 IDFM_SLOT_5_LABEL=2220

 IDFM_SLOT_6_MONITORING_REF=STIF:StopPoint:Q:15687:
 IDFM_SLOT_6_LINE_REF=STIF:Line::C00629:
 IDFM_SLOT_6_LINE_CODE=C00629
 IDFM_SLOT_6_LABEL=2226

 # Transilien P (train)
 IDFM_SLOT_7_MONITORING_REF=STIF:StopArea:SP:427872:
 IDFM_SLOT_7_LINE_REF=STIF:Line::C01730:
 IDFM_SLOT_7_LINE_CODE=C01730
 IDFM_SLOT_7_LABEL=P

 # Bus remplacement Transilien P → Paris Est
 IDFM_SLOT_8_MONITORING_REF=STIF:StopArea:SP:68494:
 IDFM_SLOT_8_LINE_REF=STIF:Line::C01841:
 IDFM_SLOT_8_LINE_CODE=C01841
 IDFM_SLOT_8_LABEL=BUS P
 IDFM_DESTINATION_FILTER=Paris Est
